module escalonador_RR_HALT (
    input  wire        clock,
    input  wire        reset,
	 
	 // Controle
    input  wire        enable_preemption,  // 1 = Round-Robin, 0 = Sem preempção
    input  wire [1:0]  manual_prog_sel,    // Seleção manual (quando preempção = 0)
    input  wire        start_execution,    // Pulso para iniciar execução
	 input  wire        program_halt,        // HALT do programa atual
    
    // Saídas
    output reg  [1:0]  current_prog,       // Programa em execução (01 ou 10)
    output reg  [31:0] prog_base_addr,     // Endereço base do programa atual
    output reg         context_switch,     // Pulso de troca de contexto
    output reg         load_program,       // Sinal para carregar novo programa
	 output reg         halt_global,          // HALT geral (todos terminaram)
    
    // Debug
    output wire [3:0]  dbg_counter,
    output wire        dbg_quantum_expired
);

    // Parâmetros
    parameter QUANTUM = 10;
    
    // Registradores internos
    reg [3:0] cycle_counter;
    reg [1:0] next_prog;
    reg quantum_expired;
    reg execution_running;

	 // Estado dos programas
    reg prog_finished [3:0];  // 1 = programa já finalizado
	 
	 integer i;
    
    // Mapeamento de programas para endereços base
    function [31:0] get_base_addr;
        input [1:0] prog_id;
        begin
            case (prog_id)
                2'b01: get_base_addr = 32'd100;  // Programa 1
                2'b10: get_base_addr = 32'd200;  // Programa 2
                default: get_base_addr = 32'd0;
            endcase
        end
    endfunction
    
    // Sinais de debug
    assign dbg_counter = cycle_counter;
    assign dbg_quantum_expired = quantum_expired;
    
    // Inicialização
    initial begin
        current_prog = 2'b01;      // Começa com programa 1
        next_prog = 2'b01;
        cycle_counter = 4'd0;
        quantum_expired = 1'b0;
        context_switch = 1'b0;
        load_program = 1'b0;
        execution_running = 1'b0;
        prog_base_addr = 32'd100;
    end
    
    // Lógica principal
    always @(posedge clock or posedge reset) begin
		  if (reset) begin
            current_prog       <= 2'b01;
            next_prog          <= 2'b01;
            cycle_counter      <= 4'd0;
            quantum_expired    <= 1'b0;
            execution_running  <= 1'b0;
            context_switch     <= 1'b0;
            load_program       <= 1'b0;
            halt_global        <= 1'b0;
            prog_base_addr     <= 32'd100;

            for (i = 0; i < 4; i = i + 1)
                prog_finished[i] <= 1'b0;
        end
        else begin
            // Limpa pulsos
            context_switch 	<= 1'b0;
            load_program 		<= 1'b0;
				quantum_expired 	<= 1'b0;
            
            // Iniciar execução
            if (start_execution && !execution_running) begin
                execution_running <= 1'b1;
					 halt_global <= 1'b0;
                cycle_counter <= 4'd0;
					 
                if (enable_preemption) begin
                    current_prog <= 2'b01;  // Começa com programa 1
                    prog_base_addr <= get_base_addr(2'b01);
                end
                else begin
                    current_prog <= manual_prog_sel;
                    prog_base_addr <= get_base_addr(manual_prog_sel);
                end
                load_program <= 1'b1;
            end
				
				// =========================
            // PROGRAMA EXECUTOU HALT
            // =========================
            else if (execution_running && program_halt) begin
                prog_finished[current_prog] <= 1'b1;
                context_switch <= 1'b1;
                cycle_counter <= 4'd0;

                // Seleciona próximo programa válido
                if (!prog_finished[2'b01] && current_prog != 2'b01)
                    next_prog <= 2'b01;
                else if (!prog_finished[2'b10] && current_prog != 2'b10)
                    next_prog <= 2'b10;
                else begin
                    // Todos finalizaram
                    halt_global <= 1'b1;
                    execution_running <= 1'b0;
                end
            end
				
            // Modo com preempção (Round-Robin)
            else if (execution_running && enable_preemption) begin
                // Incrementa contador
                cycle_counter <= cycle_counter + 4'd1;
                
                // Verifica se quantum expirou
                if (cycle_counter == (QUANTUM - 1)) begin
                    quantum_expired <= 1'b1;
						  // Sinaliza troca de contexto
                    context_switch <= 1'b1;
						  cycle_counter <= 4'd0;
                    
                    // Alterna programa válido
                    if (current_prog == 2'b01) begin
                        if (!prog_finished[2'b10])
                            next_prog <= 2'b10;
                        else
                            next_prog <= 2'b01;
                    end
                    else begin
                        if (!prog_finished[2'b01])
                            next_prog <= 2'b01;
                        else
                            next_prog <= 2'b10;
                    end
                    
                end
                // Atualiza programa atual no ciclo seguinte ao quantum
                if (quantum_expired) begin
                    current_prog <= next_prog;
                    prog_base_addr <= get_base_addr(next_prog);
						  load_program <= 1'b1;
                end
            end
            // Modo sem preempção (manual)
            else if (execution_running && !enable_preemption) begin
                // Verifica se usuário mudou o programa manualmente
                if (manual_prog_sel != current_prog && !prog_finished[manual_prog_sel]) begin
                    current_prog <= manual_prog_sel;
                    prog_base_addr <= get_base_addr(manual_prog_sel);
                    context_switch <= 1'b1;
                    load_program <= 1'b1;
                end
            end
        end
    end

endmodule
