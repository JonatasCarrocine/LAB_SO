module out_device (
    input wire        clock,
    input wire        reset,
    input wire        out_en,        // ativa quando opcode == OUT
    input wire [13:0] out_data, // dado a ser exibido
	 output reg saida_dado
);

    always @(posedge clock) begin
        if (reset) begin
            // nada
        end
        else if (out_en) begin
            saida_dado = out_data
        end
    end

endmodule